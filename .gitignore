# ── 素材处理链中间产物（跑 scripts/*.py 可再生，不入仓库） ──
step01/
step02/
step03/
step04/

# ── 素材源（托管在 GitHub Releases assets-videos，不入仓库） ──
video/*.mp4

# ── PR 手工抠像工作数据（本地工作数据，同 step 中间产物，不入库） ──
#   pr/      PR 导出的透明 .mov（路线 B 的输入）
#   prproj/  PR 工程目录（.prproj + 遮罩缓存 + 自动保存，约 2GB）
pr/
prproj/

# ── 本地工具（机器相关，不入仓库） ──
.tools/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# ── Node ──
node_modules/
.npm-cache/
.npm-tmp-cache/
npm-debug.log*
*.tgz

# ── 临时/备份目录 ──
temp/

# ── dsh-pet 构建产物 ──
# 本 fork 为了支持 DSH「输入 GitHub 仓库地址直接安装」，跟踪构建产物：
#   lib/                      tsdown bundle（lib/index.js、lib/client.js）+ tsc 声明
#   runtime/electron-helper/shared-core.js  桌面共享纯逻辑
# 修改源码后仍须 npm run build，并把更新后的产物一起提交。

# ── dsh-pet 桌宠应用打包产物（electron-builder 输出，`node scripts/dist.mjs` 可重生）──
dsh-pet/dist-app/

# ── Electron 平台可选运行时包（`npm run electron:packages` 生成，发布到 npm 后不入库）──
dsh-pet/dist-electron/

# ── IDE / 编辑器 ──
.idea/
.vscode/
*.swp

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini
